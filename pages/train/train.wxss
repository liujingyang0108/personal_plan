.header {
  padding: 32rpx 0 40rpx;
}

.header-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary-color);
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: var(--light-color);
}

.template-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.template-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: var(--card-bg);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.template-card:active {
  background: var(--bg-color);
}

.template-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
}

.template-info {
  flex: 1;
}

.template-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--primary-color);
  margin-bottom: 8rpx;
}

.template-desc {
  font-size: 24rpx;
  color: var(--light-color);
}

.template-arrow {
  font-size: 40rpx;
  color: var(--light-color);
  margin-left: 16rpx;
}

.history-btn {
  margin-top: 24rpx;
  padding: 28rpx;
  text-align: center;
  background: var(--card-bg);
  border-radius: 16rpx;
  color: var(--primary-color);
  font-size: 28rpx;
}

.history-btn:active {
  background: var(--bg-color);
}

.exercise-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 160rpx;
}

.exercise-card {
  background: var(--card-bg);
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.exercise-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.exercise-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.exercise-progress {
  font-size: 26rpx;
  color: var(--light-color);
}

.set-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.set-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: var(--bg-color);
  border-radius: 10rpx;
  font-size: 26rpx;
}

.set-item.completed {
  background: rgba(82, 196, 26, 0.1);
  color: var(--success-color);
}

.set-check {
  color: var(--success-color);
  font-size: 28rpx;
}

.exercise-actions {
  display: flex;
  gap: 16rpx;
}

.complete-btn {
  flex: 1;
  padding: 20rpx;
  background: var(--primary-color);
  color: #ffffff;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
}

.complete-btn:active {
  opacity: 0.8;
}

.rest-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.rest-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rest-title {
  font-size: 36rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
}

.rest-time {
  font-size: 120rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 32rpx;
}

.rest-hint {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

.training-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--card-bg);
  border-top: 1rpx solid var(--border-color);
  display: flex;
  gap: 20rpx;
}

.finish-btn {
  flex: 2;
  padding: 28rpx;
  background: var(--success-color);
  color: #ffffff;
  border-radius: 44rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.cancel-btn {
  flex: 1;
  padding: 28rpx;
  background: var(--bg-color);
  color: var(--primary-color);
  border-radius: 44rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
}

.finish-btn:active, .cancel-btn:active {
  opacity: 0.8;
}

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #ffffff;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #e5e5e5;
  z-index: 1000;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.tab-icon {
  font-size: 44rpx;
}

.tab-text {
  font-size: 26rpx;
  color: #999999;
}

.tab-item.active .tab-text {
  color: #333333;
  font-weight: 600;
}
