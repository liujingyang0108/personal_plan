.form-group {
  background: var(--card-bg);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--light-color);
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  padding: 20rpx 0;
  font-size: 30rpx;
  border: none;
  border-bottom: 2rpx solid var(--border-color);
  box-sizing: border-box;
}

.picker-value {
  padding: 20rpx 0;
  font-size: 30rpx;
  color: var(--primary-color);
  border-bottom: 2rpx solid var(--border-color);
}

.save-btn {
  margin-top: 40rpx;
  padding: 28rpx;
  background: var(--primary-color);
  color: #ffffff;
  border-radius: 44rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}

.save-btn:active {
  opacity: 0.8;
}
