.header {
  padding: 32rpx 0 48rpx;
}

.header-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary-color);
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: var(--light-color);
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.category-card {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.category-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.category-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.category-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary-color);
  flex: 1;
}

.category-add {
  font-size: 26rpx;
  color: var(--category-color, var(--primary-color));
  padding: 8rpx 20rpx;
  border: 2rpx solid var(--category-color, var(--primary-color));
  border-radius: 24rpx;
}

.category-add:active {
  opacity: 0.6;
}

.goal-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.goal-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
}

.goal-item:active {
  background: var(--border-color);
}

.goal-info {
  flex: 1;
}

.goal-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--primary-color);
  margin-bottom: 6rpx;
}

.goal-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.goal-date {
  font-size: 22rpx;
  color: var(--light-color);
}

.goal-status {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.status-active {
  background: rgba(69, 183, 209, 0.15);
  color: var(--learning-color);
}

.status-completed {
  background: rgba(82, 196, 26, 0.15);
  color: var(--success-color);
}

.status-paused {
  background: rgba(153, 153, 153, 0.15);
  color: var(--light-color);
}

.goal-arrow {
  font-size: 36rpx;
  color: var(--light-color);
  margin-left: 16rpx;
}

.goal-empty {
  text-align: center;
  padding: 32rpx;
  color: var(--light-color);
  font-size: 26rpx;
}

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #ffffff;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #e5e5e5;
  z-index: 1000;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.tab-icon {
  font-size: 44rpx;
}

.tab-text {
  font-size: 26rpx;
  color: #999999;
}

.tab-item.active .tab-text {
  color: #333333;
  font-weight: 600;
}
