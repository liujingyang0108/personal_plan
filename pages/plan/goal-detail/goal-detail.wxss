.goal-detail {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.goal-header {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 32rpx;
}

.goal-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.goal-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.goal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.goal-status {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.status-进行中 {
  background: rgba(69, 183, 209, 0.15);
  color: var(--learning-color);
}

.status-已完成 {
  background: rgba(82, 196, 26, 0.15);
  color: var(--success-color);
}

.status-暂停 {
  background: rgba(153, 153, 153, 0.15);
  color: var(--light-color);
}

.goal-desc, .goal-dates, .ai-plan {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 28rpx;
}

.desc-label, .plan-label {
  display: block;
  font-size: 24rpx;
  color: var(--light-color);
  margin-bottom: 12rpx;
}

.desc-content, .plan-content {
  font-size: 28rpx;
  color: var(--primary-color);
  line-height: 1.6;
}

.goal-dates {
  display: flex;
}

.date-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.date-item:first-child {
  border-right: 1rpx solid var(--border-color);
}

.date-label {
  font-size: 24rpx;
  color: var(--light-color);
  margin-bottom: 8rpx;
}

.date-value {
  font-size: 28rpx;
  color: var(--primary-color);
}

.action-section {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 28rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-color);
  margin-bottom: 20rpx;
}

.status-buttons {
  display: flex;
  gap: 16rpx;
}

.status-btn {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  background: var(--bg-color);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--primary-color);
}

.status-btn.active {
  background: var(--primary-color);
  color: #ffffff;
}
