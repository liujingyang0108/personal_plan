page {
  --fitness-color: #FF6B6B;
  --finance-color: #4ECDC4;
  --learning-color: #45B7D1;
  --work-color: #96CEB4;
  --primary-color: #333333;
  --secondary-color: #666666;
  --light-color: #999999;
  --bg-color: #f5f5f5;
  --card-bg: #ffffff;
  --border-color: #e5e5e5;
  --success-color: #52c41a;
  --warning-color: #faad14;
  --danger-color: #ff4d4f;
  font-size: 28rpx;
  color: var(--primary-color);
  background-color: var(--bg-color);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: var(--card-bg);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary-color);
  margin-bottom: 16rpx;
}

.card-subtitle {
  font-size: 24rpx;
  color: var(--light-color);
  margin-bottom: 12rpx;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.btn-primary {
  background: var(--primary-color);
  color: #ffffff;
}

.btn-primary:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-secondary {
  background: var(--bg-color);
  color: var(--primary-color);
}

.btn-secondary:active {
  background: var(--border-color);
}

.btn-danger {
  background: var(--danger-color);
  color: #ffffff;
}

.btn-success {
  background: var(--success-color);
  color: #ffffff;
}

.flex {
  display: flex;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.gap-8 { gap: 8rpx; }
.gap-12 { gap: 12rpx; }
.gap-16 { gap: 16rpx; }
.gap-24 { gap: 24rpx; }

.mt-8 { margin-top: 8rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-12 { margin-bottom: 12rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }

.text-center { text-align: center; }
.text-left { text-align: left; }
.text-right { text-align: right; }

.text-primary { color: var(--primary-color); }
.text-secondary { color: var(--secondary-color); }
.text-light { color: var(--light-color); }
.text-success { color: var(--success-color); }
.text-danger { color: var(--danger-color); }

.text-sm { font-size: 24rpx; }
.text-base { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-xxl { font-size: 44rpx; }

.font-bold { font-weight: 600; }

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: var(--light-color);
}

.empty-state-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-state-text {
  font-size: 28rpx;
  text-align: center;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  background: var(--light-color);
  border-radius: 50%;
  margin: 0 8rpx;
  animation: loading 1.2s infinite ease-in-out;
}

.loading-dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes loading {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-fitness { background: rgba(255, 107, 107, 0.15); color: var(--fitness-color); }
.tag-finance { background: rgba(78, 205, 196, 0.15); color: var(--finance-color); }
.tag-learning { background: rgba(69, 183, 209, 0.15); color: var(--learning-color); }
.tag-work { background: rgba(150, 206, 180, 0.15); color: var(--work-color); }

.progress-bar {
  width: 100%;
  height: 8rpx;
  background: var(--border-color);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.divider {
  height: 1rpx;
  background: var(--border-color);
  margin: 24rpx 0;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.checkbox.checked {
  background: var(--success-color);
  border-color: var(--success-color);
  color: #ffffff;
}

.input {
  width: 100%;
  padding: 20rpx 24rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input:focus {
  outline: 2rpx solid var(--primary-color);
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  resize: none;
}
